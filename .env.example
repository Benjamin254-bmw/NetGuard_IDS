# Copy with: make init-env   (generates random secrets, sets mode 600). Never commit .env.
NETGUARD_ENV=development          # development | test | production
NETGUARD_LOG_LEVEL=INFO
NETGUARD_LOG_FORMAT=text          # text | json

NETGUARD_DB_HOST=127.0.0.1
NETGUARD_DB_PORT=5432
NETGUARD_DB_NAME=netguard
NETGUARD_DB_MIGRATOR_USER=netguard_migrator
NETGUARD_DB_MIGRATOR_PASSWORD=CHANGE_ME
NETGUARD_DB_MONITOR_USER=netguard_monitor
NETGUARD_DB_MONITOR_PASSWORD=CHANGE_ME
NETGUARD_DB_API_USER=netguard_api
NETGUARD_DB_API_PASSWORD=CHANGE_ME

# API (used from Phase 5)
NETGUARD_SECRET_KEY=CHANGE_ME

# Monitor: both must be set explicitly before capture/discovery is allowed (Phase 3).
NETGUARD_MONITOR_INTERFACE=
NETGUARD_AUTHORIZED_SUBNET=

# Monitor tuning (all optional; bounded in code). Environment variables override this file.
NETGUARD_CAPTURE_QUEUE_SIZE=10000
NETGUARD_WRITE_QUEUE_SIZE=500
NETGUARD_FLOW_CAP_PER_MINUTE=5000
NETGUARD_INACTIVE_AFTER_SECONDS=300
NETGUARD_PROMISCUOUS=false                  # true only for mirror/SPAN ports; ends when the monitor stops
NETGUARD_ACTIVE_DISCOVERY=false             # ARP sweep of the authorized subnet; passive discovery is always on
NETGUARD_ACTIVE_DISCOVERY_INTERVAL_SECONDS=300
NETGUARD_RETENTION_1S_HOURS=24
NETGUARD_RETENTION_1M_DAYS=30
NETGUARD_SPILL_DIR=var/spill
NETGUARD_SPILL_MAX_MB=100

# Detection (Phase 4)
NETGUARD_AUTH_LOG_PATH=            # e.g. /var/log/auth.log (sshd failures); empty = rule idle
NETGUARD_RULES_RELOAD_SECONDS=10
